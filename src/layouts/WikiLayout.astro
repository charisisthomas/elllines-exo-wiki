---
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import UsefulLinks from '../components/UsefulLinks.astro';

interface Props {
  title: string;
  description?: string;
  category: string;
  lastUpdated: string;
  lang: 'el' | 'en';
  headings: any[];
  slug: string;
  usefulLinks?: string[];
}

const { title, description, category, lastUpdated, lang, headings, slug, usefulLinks = [] } = Astro.props;

// Fetch all articles for the sidebar
const collectionName = lang === 'el' ? 'wiki' : 'wiki-en';
const allArticles = await getCollection(collectionName);
allArticles.sort((a, b) => a.id.localeCompare(b.id));

// Find prev/next
const currentIndex = allArticles.findIndex(a => a.id === slug);
const prevArticle = currentIndex > 0 ? allArticles[currentIndex - 1] : null;
const nextArticle = currentIndex < allArticles.length - 1 ? allArticles[currentIndex + 1] : null;

// Generate base path for links
const basePath = lang === 'el' ? '' : '/en';

// Format date
const dateObj = new Date(lastUpdated);
const formattedDate = new Intl.DateTimeFormat(lang === 'el' ? 'el-GR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(dateObj);
---

<Layout title={title} description={description} lang={lang}>
  <div class="container mx-auto px-4 py-8 flex gap-8 relative items-start">
    
    <!-- Mobile Sidebar Toggle -->
    <div class="lg:hidden fixed bottom-6 right-6 z-50">
      <button id="mobile-sidebar-toggle" class="bg-primary-600 text-white p-4 rounded-full shadow-xl hover:bg-primary-700 transition-colors focus:outline-none" aria-label="Toggle Menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Sidebar Overlay -->
    <div id="mobile-overlay" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden backdrop-blur-sm transition-opacity opacity-0"></div>

    <!-- Left Sidebar -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-white border-r border-slate-200 transform -translate-x-full lg:translate-x-0 lg:static lg:block lg:w-64 lg:bg-transparent lg:border-r-0 lg:flex-shrink-0 transition-transform duration-300 ease-in-out">
      <div class="h-full overflow-y-auto lg:sticky lg:top-24 lg:max-h-[calc(100vh-6rem)] p-6 lg:p-0">
        <div class="flex items-center justify-between lg:hidden mb-6 pb-6 border-b border-slate-100">
          <span class="font-bold text-lg text-slate-900">Μενού</span>
          <button id="close-sidebar" class="text-slate-500 hover:text-slate-700 p-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        
        <div class="space-y-1">
          <h3 class="font-bold text-slate-900 mb-4 px-3 text-sm uppercase tracking-wider">{lang === 'el' ? 'Ενότητες' : 'Sections'}</h3>
          <ul class="space-y-1">
            {allArticles.map((article) => {
              const isActive = article.id === slug;
              const href = `${basePath}/${article.id.replace('.md', '')}`;
              return (
                <li>
                  <a 
                    href={href}
                    class={`block px-3 py-2 rounded-lg text-sm transition-colors ${
                      isActive 
                        ? 'bg-primary-50 text-primary-700 font-semibold shadow-sm border border-primary-100' 
                        : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 font-medium'
                    }`}
                  >
                    {article.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 min-w-0 max-w-3xl mx-auto w-full">
      <!-- Breadcrumbs -->
      <nav class="flex text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-2">
          <li class="inline-flex items-center">
            <a href={lang === 'el' ? '/' : '/en/'} class="inline-flex items-center hover:text-primary-600 transition-colors">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path></svg>
              {lang === 'el' ? 'Αρχική' : 'Home'}
            </a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-5 h-5 text-slate-300" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <span class="ml-1 md:ml-2 font-medium">{category}</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Article Header -->
      <div class="mb-10 pb-6 border-b border-slate-200">
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4 tracking-tight leading-tight">{title}</h1>
        <div class="flex items-center gap-4 text-sm">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-600 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            {lang === 'el' ? 'Τελευταία ενημέρωση:' : 'Last updated:'} {formattedDate}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 font-medium border border-emerald-100">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            {lang === 'el' ? 'Επίσημες Πηγές' : 'Official Sources'}
          </span>
        </div>
      </div>

      <!-- Markdown Content -->
      <article class="prose prose-slate max-w-none w-full" data-pagefind-body>
        <slot />
      </article>

      <!-- Assistance Banner -->
      <div class="my-12 bg-primary-50 rounded-2xl p-6 md:p-8 border border-primary-100 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
        <div>
          <h3 class="text-2xl font-bold text-primary-900 mb-2">{lang === 'el' ? 'Χρειάζεστε Βοήθεια;' : 'Need Assistance?'}</h3>
          <p class="text-primary-700">{lang === 'el' ? 'Επικοινωνήστε με έναν πιστοποιημένο λογιστή στην Ελλάδα.' : 'Contact a certified accountant in Greece.'}</p>
        </div>
        <a href={lang === 'el' ? '/contact' : '/en/contact'} class="px-6 py-3 bg-primary-600 text-white font-bold rounded-xl hover:bg-primary-700 hover:shadow-md transition-all whitespace-nowrap text-center">
          {lang === 'el' ? 'Επικοινωνία' : 'Contact Us'}
        </a>
      </div>

      <!-- Useful Links Widget -->
      {usefulLinks && usefulLinks.length > 0 && (
        <UsefulLinks links={usefulLinks} lang={lang} />
      )}

      <!-- Previous / Next Navigation -->
      <div class="mt-16 pt-8 border-t border-slate-200 grid grid-cols-1 md:grid-cols-2 gap-4">
        {prevArticle ? (
          <a href={`${basePath}/${prevArticle.id.replace('.md', '')}`} class="flex flex-col p-4 rounded-xl border border-slate-200 hover:border-primary-300 hover:bg-primary-50 hover:shadow-sm transition-all group">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
              {lang === 'el' ? 'Προηγούμενο' : 'Previous'}
            </span>
            <span class="font-bold text-primary-700">{prevArticle.data.title}</span>
          </a>
        ) : <div></div>}
        
        {nextArticle ? (
          <a href={`${basePath}/${nextArticle.id.replace('.md', '')}`} class="flex flex-col p-4 rounded-xl border border-slate-200 hover:border-primary-300 hover:bg-primary-50 hover:shadow-sm transition-all text-right group items-end">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1 flex items-center gap-1">
              {lang === 'el' ? 'Επόμενο' : 'Next'}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover:translate-x-1 transition-transform"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </span>
            <span class="font-bold text-primary-700">{nextArticle.data.title}</span>
          </a>
        ) : <div></div>}
      </div>
    </div>

    <!-- Right Sidebar (TOC) -->
    <aside class="w-64 flex-shrink-0 hidden xl:block">
      <TableOfContents headings={headings} title={lang === 'el' ? 'Περιεχόμενα' : 'Contents'} />
    </aside>
  </div>
</Layout>

<script>
  // Mobile Sidebar Toggle Logic
  document.addEventListener('astro:page-load', () => {
    const trigger = document.getElementById('mobile-sidebar-toggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('mobile-overlay');
    const closeBtn = document.getElementById('close-sidebar');

    if (!trigger || !sidebar || !overlay || !closeBtn) return;

    function openSidebar() {
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('hidden');
      setTimeout(() => overlay.classList.remove('opacity-0'), 10);
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('opacity-0');
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }

    trigger.addEventListener('click', openSidebar);
    closeBtn.addEventListener('click', closeSidebar);
    overlay.addEventListener('click', closeSidebar);
  });
</script>
