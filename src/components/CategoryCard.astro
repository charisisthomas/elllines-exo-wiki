---
interface Props {
  href: string;
  title: string;
  subtitle: string;
  description: string;
  icon: string;
  articleCount?: number;
}

const { href, title, subtitle, description, icon, articleCount = 1 } = Astro.props;
---

<a href={href} class="group flex flex-col bg-white border border-slate-200 rounded-2xl p-6 hover:shadow-xl hover:border-primary-300 transition-all duration-300 relative overflow-hidden h-full">
  <!-- Hover gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-0"></div>
  
  <div class="relative z-10 flex flex-col h-full">
    <div class="flex items-start justify-between mb-4">
      <div class="w-12 h-12 bg-primary-100 text-2xl flex items-center justify-center rounded-xl shadow-inner group-hover:scale-110 transition-transform duration-300">
        {icon}
      </div>
      {articleCount > 0 && (
        <span class="bg-slate-100 text-slate-600 text-xs font-semibold px-2 py-1 rounded-full group-hover:bg-primary-100 group-hover:text-primary-700 transition-colors">
          {articleCount} {articleCount === 1 ? 'Άρθρο' : 'Άρθρα'}
        </span>
      )}
    </div>
    
    <h3 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-primary-700 transition-colors">{title}</h3>
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3">{subtitle}</p>
    
    <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-grow">{description}</p>
    
    <div class="mt-auto flex items-center text-primary-600 text-sm font-semibold group-hover:text-primary-800 transition-colors">
      <span>Διαβάστε περισσότερα</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 ml-1.5 group-hover:translate-x-1.5 transition-transform">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </div>
  </div>
</a>
