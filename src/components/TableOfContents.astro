---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  title: string;
}

const { headings, title } = Astro.props;
// Filter only h2 and h3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <div class="sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto pr-4 hidden xl:block">
    <h3 class="font-bold text-slate-900 mb-4 text-sm uppercase tracking-wider">{title}</h3>
    <ul class="space-y-2.5 text-sm">
      {tocHeadings.map((heading) => (
        <li class={`${heading.depth === 3 ? 'pl-4' : ''}`}>
          <a 
            href={`#${heading.slug}`} 
            class="block text-slate-500 hover:text-primary-600 transition-colors leading-tight"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
