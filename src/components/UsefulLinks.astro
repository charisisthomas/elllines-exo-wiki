---
interface Props {
  links: string[];
  lang: 'el' | 'en';
}

const { links, lang } = Astro.props;
const title = lang === 'el' ? 'Χρήσιμοι Σύνδεσμοι' : 'Useful Links';

// Link metadata mapping
const linkData: Record<string, { title: string, desc: string, icon: string }> = {
  'myAADE.gov.gr': {
    title: 'myAADE',
    desc: lang === 'el' ? 'Ψηφιακή πύλη ΑΑΔΕ' : 'AADE Digital Portal',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" /></svg>`
  },
  'e-efka.gov.gr': {
    title: 'e-ΕΦΚΑ',
    desc: lang === 'el' ? 'Κοινωνική Ασφάλιση' : 'Social Security',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>`
  },
  'gov.gr': {
    title: 'gov.gr',
    desc: lang === 'el' ? 'Ενιαία Ψηφιακή Πύλη' : 'Unified Digital Portal',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>`
  },
  'aade.gr/omogeneis': {
    title: 'ΑΑΔΕ Ομογενείς',
    desc: lang === 'el' ? 'Πύλη για Ομογενείς' : 'Expats Portal',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-blue-600"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" /></svg>`
  }
};

// Fallback for unknown links
const getLinkInfo = (link: string) => {
  return linkData[link] || {
    title: link,
    desc: lang === 'el' ? 'Εξωτερικός Σύνδεσμος' : 'External Link',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>`
  };
};

const processedLinks = links && links.length > 0 ? links : ['myAADE.gov.gr', 'e-efka.gov.gr', 'gov.gr'];
---

<div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mt-10">
  <h3 class="font-bold text-slate-900 mb-4 flex items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-blue-600">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
    </svg>
    {title}
  </h3>
  <div class="space-y-3">
    {processedLinks.map(link => {
      const info = getLinkInfo(link);
      const href = link.startsWith('http') ? link : `https://${link}`;
      return (
        <a 
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-start gap-3 p-3 bg-white hover:bg-blue-50 hover:border-blue-200 border border-transparent rounded-xl transition-all group shadow-sm"
        >
          <div class="mt-0.5" set:html={info.icon} />
          <div>
            <p class="font-medium text-slate-800 group-hover:text-blue-700 transition-colors">{info.title}</p>
            <p class="text-xs text-slate-500 mt-0.5">{info.desc}</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-slate-300 group-hover:text-blue-500 ml-auto mt-1 transition-colors">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" />
          </svg>
        </a>
      );
    })}
  </div>
</div>
