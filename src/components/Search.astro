---
interface Props {
  lang?: 'el' | 'en';
}

const { lang = 'el' } = Astro.props;
const placeholder = lang === 'el' ? 'Αναζήτηση...' : 'Search...';
---

<div class="relative group">
  <button id="search-trigger" class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-700 px-3 py-1.5 md:px-4 md:py-2 rounded-full transition-all w-10 md:w-64 border border-slate-200 group-hover:border-slate-300 group-hover:shadow-sm" aria-label={placeholder}>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
    </svg>
    <span class="hidden md:inline text-sm">{placeholder}</span>
    <span class="hidden md:flex ml-auto items-center text-xs font-mono bg-white border border-slate-200 px-1.5 py-0.5 rounded text-slate-400">⌘K</span>
  </button>
</div>

<!-- Search Modal -->
<div id="search-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden flex items-start justify-center pt-20 px-4 opacity-0 transition-opacity duration-200">
  <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-200" id="search-container">
    <div class="p-4 border-b border-slate-100 flex items-center justify-between">
      <h2 class="font-semibold text-slate-800">{lang === 'el' ? 'Αναζήτηση' : 'Search'}</h2>
      <button id="close-search" class="text-slate-400 hover:text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-full p-1.5 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-4 max-h-[70vh] overflow-y-auto">
      <div id="pagefind-search"></div>
    </div>
  </div>
</div>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    initSearch();
  });
  
  // Also run on initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }

  function initSearch() {
    const trigger = document.getElementById('search-trigger');
    const modal = document.getElementById('search-modal');
    const closeBtn = document.getElementById('close-search');
    const container = document.getElementById('search-container');
    let pagefindInstantiated = false;

    if (!trigger || !modal) return;

    function openModal() {
      modal.classList.remove('hidden');
      // Trigger reflow
      void modal.offsetWidth;
      modal.classList.remove('opacity-0');
      container.classList.remove('scale-95');
      document.body.style.overflow = 'hidden';

      if (!pagefindInstantiated) {
        // Load Pagefind UI
        const script = document.createElement('script');
        script.src = "/pagefind/pagefind-ui.js";
        script.onload = () => {
          new PagefindUI({ 
            element: "#pagefind-search", 
            showSubResults: true,
            showImages: false
          });
          pagefindInstantiated = true;
          // Focus input
          setTimeout(() => {
            const input = document.querySelector('.pagefind-ui__search-input');
            if (input) input.focus();
          }, 100);
        };
        document.head.appendChild(script);
      } else {
        setTimeout(() => {
          const input = document.querySelector('.pagefind-ui__search-input');
          if (input) input.focus();
        }, 100);
      }
    }

    function closeModal() {
      modal.classList.add('opacity-0');
      container.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 200);
    }

    trigger.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Keyboard shortcut CMD+K or CTRL+K
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (modal.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      }
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }
</script>

<style is:global>
  @reference "../styles/global.css";
  /* Custom Pagefind Overrides */
  .pagefind-ui__search-input {
    @apply w-full border-2 border-primary-500 rounded-xl px-4 py-3 outline-none text-slate-800 transition-shadow focus:shadow-md bg-white font-sans;
  }
  .pagefind-ui__search-clear {
    @apply bg-slate-100 text-slate-600 rounded-lg px-3 py-1 hover:bg-slate-200 transition-colors cursor-pointer text-sm font-medium;
  }
  .pagefind-ui__result {
    @apply border-b border-slate-100 py-4;
  }
  .pagefind-ui__result-title {
    @apply font-semibold text-primary-600 text-lg mb-1;
  }
  .pagefind-ui__result-excerpt {
    @apply text-slate-600 text-sm leading-relaxed;
  }
  .pagefind-ui__result-excerpt mark {
    @apply bg-primary-100 text-primary-900 px-1 rounded-sm font-medium;
  }
  .pagefind-ui__message {
    @apply text-slate-500 py-4 font-medium;
  }
  .pagefind-ui__button {
    @apply mt-4 bg-slate-100 text-slate-700 font-medium py-2 px-4 rounded-lg w-full hover:bg-slate-200 transition-colors border-0 cursor-pointer;
  }
</style>
